# ============================================================
# MandarinVerse — Environment Variables Configuration
# Salin file ini ke .env.local untuk konfigurasi lokal Anda.
# JANGAN pernah menyimpan nilai nyata di file ini.
# ============================================================
#
# Keterangan:
#   [WAJIB]   = harus diisi, aplikasi akan gagal tanpa ini
#   [OPSIONAL] = aman untuk dikosongkan, fitur terkait dinonaktifkan
#
# ============================================================

# ============================================================
# 1. DATABASE — Neon PostgreSQL [WAJIB di produksi]
# ============================================================
# Dapatkan connection string dari https://console.neon.tech
# Format: postgres://<user>:<password>@<host>/<db>?sslmode=require
#
# Tanpa ini:
#   - Di lokal (development): data tersimpan di .data/store.json (tidak persisten)
#   - Di produksi (Vercel): aplikasi akan menolak semua permintaan data pengguna
DATABASE_URL=

# ============================================================
# 2. BETTER AUTH — Autentikasi [WAJIB]
# ============================================================

# Kunci rahasia sesi — minimal 32 karakter acak.
# Hasilkan dengan: openssl rand -base64 32
# WAJIB di produksi. Tidak boleh dikosongkan atau menggunakan nilai contoh.
BETTER_AUTH_SECRET=

# URL publik aplikasi Anda.
# Lokal   : http://localhost:3000
# Produksi: https://mandarinverse.vercel.app  (atau domain Anda)
BETTER_AUTH_URL=http://localhost:3000

# URL publik yang dikirim ke klien (harus sama dengan BETTER_AUTH_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# 3. AI MANDARIN TUTOR [OPSIONAL]
# ============================================================
# Tanpa konfigurasi ini, fitur Tutor AI dinonaktifkan dengan pesan yang jelas.
# Provider yang didukung: gemini | openai | groq | openrouter

AI_PROVIDER=gemini

# API key untuk provider yang dipilih
AI_API_KEY=

# Model yang digunakan (contoh: gemini-1.5-flash, gpt-4o-mini, llama-3.3-70b-versatile)
AI_MODEL=gemini-1.5-flash

# Provider cadangan opsional, dipakai jika Gemini gagal karena overload/rate limit
# atau gangguan jaringan. Provider cadangan harus OpenAI-compatible:
# openai | groq | openrouter. Isi ketiganya agar fitur aktif.
# Contoh Groq: AI_FALLBACK_PROVIDER=groq
# AI_FALLBACK_MODEL=llama-3.3-70b-versatile
# Simpan API key hanya di .env.local/Vercel, jangan commit nilainya.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# ============================================================
# 4. CLOUDFLARE R2 — Penyimpanan Aset [OPSIONAL]
# ============================================================
# Tanpa konfigurasi ini, aset audio/gambar tidak diunggah ke R2.
# Konten kurikulum tetap berfungsi menggunakan teks/pinyin.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
