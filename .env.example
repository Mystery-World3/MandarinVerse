# ========================================================
# MandarinVerse - Environment Variables Configuration
# Salin file ini ke .env.local untuk konfigurasi lokal Anda
# ========================================================

# 1. DATABASE (Neon PostgreSQL)
# Dapatkan connection string dari dashboard https://console.neon.tech
DATABASE_URL=postgres://neondb_owner:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. BETTER AUTHENTICATION
# Hasilkan string acak minimal 32 karakter (misal: openssl rand -base64 32)
BETTER_AUTH_SECRET=ganti-dengan-kunci-rahasia-minimal-32-karakter-acak
# URL publik aplikasi (di localhost gunakan http://localhost:3000, di produksi gunakan domain Vercel Anda)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. AI MANDARIN TUTOR (Opsional namun direkomendasikan)
# Provider yang didukung: "gemini" (default), "openai", "groq", "openrouter"
AI_PROVIDER=gemini
AI_API_KEY=
# Model yang digunakan (contoh: gemini-1.5-flash, gpt-4o-mini, llama-3.3-70b-versatile)
AI_MODEL=gemini-1.5-flash

# 4. CLOUDFLARE R2 ASSET STORAGE (Opsional)
# Digunakan jika Anda ingin menyimpan audio dan aset kustom di Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
